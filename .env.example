API_KEY=

# Model: alias (sdxl | sdxl-lightning | dreamshaper | flux-schnell) or full @cf/ path
DEFAULT_MODEL=@cf/stabilityai/stable-diffusion-xl-base-1.0

# Image dimensions (pixels)
DEFAULT_WIDTH=1024
DEFAULT_HEIGHT=1024

# Inference steps (flux-schnell is capped at 8 automatically)
DEFAULT_STEPS=20

# Guidance scale
DEFAULT_GUIDANCE=7.5

# Seed (omit or leave blank for random)
DEFAULT_SEED=
